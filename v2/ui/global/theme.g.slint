export global Palette {
    out property <color> bg: #1e1e1e;
    out property <color> header-bg: #2d2d2d;
    out property <color> border: #3c3c3c;
    out property <color> row-hover: #2a2d2e;
    out property <color> row-selected: #094771;
    out property <color> text: #d4d4d4;
    out property <color> text-dim: #9a9a9a;
}

export global Metrics {
    out property <length> header-height: 32px;
    out property <length> row-height: 28px;
    out property <length> cell-spacing: 4px;
    out property <length> cell-padding: 8px;
}
